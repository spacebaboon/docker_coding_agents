# Copy to .env (git-ignored) and customize for your machine.

# Host directory mounted at /workspace inside the container. This is where your
# projects live; the container only ever sees what you mount here.
# Can be absolute or relative to docker-compose.yml. Default: ../projects
#PROJECTS_DIR=../projects

# Absolute host path to the SAME directory as PROJECTS_DIR. Used by
# docker-compose.override.yml to bind-mount projects at an identical path on both
# sides, so docker compose / make commands run from inside the container resolve
# relative bind mounts correctly. Must resolve to the same directory PROJECTS_DIR
# points at.
#HOST_PROJECTS_DIR=/path/to/your/projects

# Two fine-grained GitHub PATs select access by context (there is no single ambient
# token). See the gh wrapper script (gh-wrapper.sh, installed on PATH) and the baked
# git config (gitconfig) for how each one is used.
#
# GH_TOKEN_RW - READ-WRITE. Repo access: the project(s) you want the agent to push
#   to. Suggested permissions: Contents RW, Pull requests RW, Metadata R, Issues R,
#   Actions R, Checks R, Commit statuses R.
#GH_TOKEN_RW=[TOKEN]
#
# GH_TOKEN_RO - READ-ONLY, the safe default for every other repo. Suggested
#   permissions: Contents R, Pull requests R, Metadata R, Issues R, Actions R,
#   Checks R, Commit statuses R. (Issues R = PR conversation comments; Actions /
#   Checks / Commit statuses = CI build outcomes, run logs and PR check badges.)
#GH_TOKEN_RO=[TOKEN]

# Absolute in-container path of the read-write project tree (under /workspace). The
# gh wrapper script uses the read-write token inside this tree and the read-only
# token everywhere else. Mirror this path in your git config includeIf
# (see gitconfig.example).
#GH_RW_TREE=/workspace/path/to/your/rw-project
